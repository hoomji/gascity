#!/usr/bin/env bash
# Ensure the golangci-lint at BINARY is the pinned VERSION, built with a Go
# toolchain at least as new as this module's go.mod. Reinstall otherwise.
#
#   scripts/ensure-golangci-lint BINARY VERSION
#
# An existing binary is not enough: golangci-lint refuses to load a module
# whose go.mod targets a newer Go than the one it was built with ("the Go
# language version (go1.26) used to build golangci-lint is lower than the
# targeted Go version (1.27.3)"). The install pins GOTOOLCHAIN because
# `go install pkg@version` otherwise builds with the toolchain named by
# golangci-lint's own go.mod, not ours.
set -euo pipefail

if [ "$#" -ne 2 ]; then
  echo "usage: $0 BINARY VERSION" >&2
  exit 2
fi
binary=$1
want_version=$2

repo_root=$(cd "$(dirname "$0")/.." && pwd)
want_go=$(sed -n 's/^toolchain go//p' "$repo_root/go.mod" | head -1)
if [ -z "$want_go" ]; then
  want_go=$(sed -n 's/^go //p' "$repo_root/go.mod" | head -1)
fi
if [ -z "$want_go" ]; then
  echo "ensure-golangci-lint: no go directive in $repo_root/go.mod" >&2
  exit 1
fi

# version_ge A B: true when version A >= version B.
version_ge() {
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" = "$2" ]
}

if [ -x "$binary" ]; then
  info=$("$binary" version 2>/dev/null || true)
  have_version=$(printf '%s\n' "$info" | sed -n 's/.* version \([^ ]*\) built with.*/\1/p' | head -1)
  have_go=$(printf '%s\n' "$info" | sed -n 's/.* built with go\([^ ]*\).*/\1/p' | head -1)
  if [ "$have_version" = "$want_version" ] && [ -n "$have_go" ] && version_ge "$have_go" "$want_go"; then
    exit 0
  fi
  echo "golangci-lint at $binary is v${have_version:-unknown} built with go${have_go:-unknown}; want v$want_version built with go$want_go or newer"
fi

echo "Installing golangci-lint v$want_version with go$want_go..."
attempt=1
max_attempts=5
delay=2
while [ "$attempt" -le "$max_attempts" ]; do
  echo "golangci-lint install attempt $attempt/$max_attempts"
  if GOTOOLCHAIN="go$want_go" GOBIN="$(dirname "$binary")" \
    go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v$want_version"; then
    exit 0
  fi
  if [ "$attempt" -lt "$max_attempts" ]; then
    echo "golangci-lint install failed; retrying in ${delay}s..." >&2
    sleep "$delay"
  fi
  attempt=$((attempt + 1))
  delay=$((delay * 2))
done
echo "ERROR: failed to install golangci-lint v$want_version after $max_attempts attempts" >&2
exit 1
